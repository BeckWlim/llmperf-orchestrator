# LLMPerf minimal environment template
# Copy to .env, replace endpoint/key values, and never commit the resulting file.
# Benchmark workload parameters belong in Runner YAML, not in this service file.

# PostgreSQL. The hostless URL uses the current Linux user and Unix socket.
DATABASE_URL=postgresql+asyncpg:///llmperf

# OpenAI-compatible provider. Adapter, model discovery path, and cache TTL are
# inferred as openai, /models, and 300 seconds.
LLMPERF_PROVIDER_DEEPSEEK_URL=http://127.0.0.1:8001/v1
LLMPERF_PROVIDER_DEEPSEEK_KEY=EMPTY

# Defaults used only when a submitted Runner does not select its own values.
LLMPERF_DEFAULT_PROVIDER=deepseek
LLMPERF_DEFAULT_MODEL=deepseek-chat
LLMPERF_DEFAULT_TOKENIZER=hf-internal-testing/llama-tokenizer

# Optional authentication. Uncomment after creating the bootstrap public key.
# LLMPERF_AUTH_ENABLED=true
# LLMPERF_AUTH_PUBLIC_KEY_PATH=.secrets/llmperfctl.pub
# LLMPERF_BOOTSTRAP_SUBJECT=xffan2

# Optional runtime overrides; packaged defaults are normally sufficient.
# LLMPERF_SERVER_HOST=127.0.0.1
# LLMPERF_SERVER_PORT=8000
# LLMPERF_SERVER_RELOAD=true
# LLMPERF_LOG_LEVEL=info
# LLMPERF_LOG_COLOR=auto
# LLMPERF_MAX_CONCURRENT_RUNNERS=1
# LLMPERF_DATABASE_AUTO_CREATE_SCHEMA=true

# Server-owned cache for tokenizers selected by Runner YAML.
# LLMPERF_TOKENIZER_CACHE_DIR=/absolute/path/to/llmperf-tokenizers
# Explicit proxy used only for Hugging Face tokenizer resolution. This is passed
# directly to Transformers and does not depend on service/system proxy discovery.
# LLMPERF_TOKENIZER_PROXY=http://proxy.example.com:3128
# Reject remote lookup and resolve submitted tokenizers only from the cache.
# LLMPERF_TOKENIZER_LOCAL_FILES_ONLY=false

# Additional OpenAI-compatible provider: only URL and key are required.
# LLMPERF_PROVIDER_GLM_URL=https://open.bigmodel.cn/api/paas/v4
# LLMPERF_PROVIDER_GLM_KEY=replace-with-real-key

# A non-OpenAI adapter can declare a static model catalog. The Anthropic key
# environment name and static discovery mode are inferred automatically.
# LLMPERF_PROVIDER_ANTHROPIC_ADAPTER=anthropic
# LLMPERF_PROVIDER_ANTHROPIC_KEY=replace-with-real-key
# LLMPERF_PROVIDER_ANTHROPIC_MODELS=claude-sonnet-4-5,claude-haiku-4-5

# Advanced provider overrides, needed only when inference is insufficient:
# LLMPERF_PROVIDER_<ID>_DISCOVERY=openai|static|disabled
# LLMPERF_PROVIDER_<ID>_MODELS_PATH=/models
# LLMPERF_PROVIDER_<ID>_CACHE_TTL=300
# LLMPERF_PROVIDER_<ID>_URL_ENV=OPENAI_API_BASE
# LLMPERF_PROVIDER_<ID>_KEY_ENV=OPENAI_API_KEY

# Optional file locations.
# LLMPERF_ENV_FILE=/absolute/path/to/llmperf.env
# LLMPERF_BACKEND_CONFIG=/absolute/path/to/backend.yaml

# CLI-only values are best exported in the shell running llmperfctl.
# LLMPERF_URL=http://127.0.0.1:8000
# LLMPERF_SSH_DIR=/home/user/.ssh
# LLMPERF_PRIVATE_KEY=/home/user/.config/llmperf/llmperfctl

HTTP_PROXY=http://172.25.160.1:7890
HTTPS_PROXY=http://172.25.160.1:7890
