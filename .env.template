# LLMPerf minimal environment template
# Reference template. Persist settings with `llmperf-backend config set`, or point
# LLMPERF_ENV_FILE at an explicit private copy; working-directory .env is not loaded.
# Benchmark workload parameters belong in Runner YAML, not in this service file.

# PostgreSQL. The hostless URL uses the current Linux user and Unix socket.
DATABASE_URL=postgresql+asyncpg:///llmperf

# Define all Provider profiles in providers.yaml beside backend.env.
# Copy src/llmperf_backend/configuration/configs/providers.example.yaml there and edit it.
# LLMPERF_PROVIDERS_FILE selects another YAML/JSON file, relative to backend.env.
# LLMPERF_PROVIDERS_FILE=providers.yaml
# Keep only credentials referenced by api_key_env here; profile fields are not supported.
# ALIYUN_API_KEY=replace-with-real-key

# Defaults used only when a submitted Runner does not select its own values.
LLMPERF_DEFAULT_PROVIDER=local
LLMPERF_DEFAULT_MODEL=local-model
LLMPERF_DEFAULT_TOKENIZER=hf-internal-testing/llama-tokenizer

# Optional authentication. Uncomment after creating the bootstrap public key.
# LLMPERF_AUTH_ENABLED=true
# LLMPERF_AUTH_KEY=.secrets/llmperfctl.pub
# LLMPERF_BOOTSTRAP_SUBJECT=xffan2

# Optional runtime overrides; packaged defaults are normally sufficient.
# LLMPERF_SERVER_HOST=127.0.0.1
# LLMPERF_SERVER_PORT=8000
# LLMPERF_SERVER_WORKERS=1
# LLMPERF_SERVER_RELOAD=false
# LLMPERF_LOG_LEVEL=info
# LLMPERF_LOG_COLOR=auto
# Active Runner handles have an independent bound. Physical request slots equal
# floor(Ray CPUs / actor CPUs) times requests per actor, capped by runtime guards:
# LLMPERF_RUNNERS_MAX=64
# Leave the address empty for a Backend-owned embedded Ray runtime. One active
# Backend owns each database, including when using an external Ray cluster.
# LLMPERF_RAY_ADDRESS=
# LLMPERF_RAY_CPUS=8
# LLMPERF_RAY_ACTOR_CPUS=1.0
# Concurrent requests within each shared actor, across all Runners.
# LLMPERF_RAY_ACTOR_MAX_CONCURRENCY=8
# LLMPERF_RAY_OBJECT_STORE_BYTES=268435456
# LLMPERF_RAY_HEALTH_INTERVAL=5.0
# LLMPERF_RAY_HEALTH_TIMEOUT=3.0
# Admission limits reject a workload before execution. Effective concurrency is
# bounded by active Runner demand and shared physical request capacity.
# LLMPERF_PERFORMANCE_GUARD_ENABLED=true
# LLMPERF_MAX_RUNNER_CONCURRENCY=64
# LLMPERF_MAX_EFFECTIVE_CONCURRENCY=64
# LLMPERF_DB_AUTOCREATE=true

# Server-owned cache for tokenizers selected by Runner YAML.
# LLMPERF_TOKENIZER_CACHE=/absolute/path/to/llmperf-tokenizers
# Backend-wide outbound proxy. LLMPerf exports this value through uppercase and
# lowercase HTTP_PROXY, HTTPS_PROXY, and ALL_PROXY aliases before importing clients,
# including native hf-xet. Provider traffic uses the same proxy by design.
# LLMPERF_PROXY=http://proxy.example.com:3128
# Backend-to-Ray gRPC remains direct; LLMPerf forces Ray's HTTP-proxy option off.
# Optional bypass list, exported as both NO_PROXY and no_proxy.
# LLMPERF_NO_PROXY=127.0.0.1,localhost
# Reject remote lookup and resolve submitted tokenizers only from the cache.
# LLMPERF_TOKENIZER_OFFLINE=false

# Backend-owned cache for datasets resolved from Runner specifications.
# LLMPERF_DATASET_CACHE=/absolute/path/to/llmperf-datasets
# Standard Hugging Face Datasets cache for normalized Arrow indexes shared by the
# Backend preflight and local Ray Workers.
# HF_DATASETS_CACHE=/absolute/path/to/huggingface-datasets
# Reject remote lookup and resolve submitted datasets only from the cache.
# LLMPERF_DATASET_OFFLINE=false

# Parallel built-in prompt preparation (reserve these CPUs in LLMPERF_RAY_CPUS).
# LLMPERF_PREPARATION_WORKERS=8
# LLMPERF_PREPARATION_CHUNK_SIZE=16
# LLMPERF_PREPARATION_BUFFER_CHUNKS=8
# Example: RAY_CPUS=16 leaves eight CPUs for eight one-CPU request actors.
# Optional file locations. For deployments, prefer persistent settings managed
# by `llmperf-backend config set NAME VALUE` in ~/.config/llmperf/backend.env.
# LLMPERF_ENV_FILE=/absolute/path/to/llmperf.env
# LLMPERF_BACKEND_CONFIG=/absolute/path/to/backend.yaml

# CLI-only values belong in ~/.config/llmperf/cli.env or may be exported in the
# shell running llmperfctl. Set LLMPERF_CLI_ENV_FILE to select another file.
# LLMPERF_CLI_ENV_FILE=/absolute/path/to/cli.env
# LLMPERF_URL=http://127.0.0.1:8000
# LLMPERF_SSH_DIR=/home/user/.ssh
# LLMPERF_PRIVATE_KEY=/home/user/.config/llmperf/llmperfctl
